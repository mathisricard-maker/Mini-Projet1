# Modèle de configuration de l'API.
# 1. Copier ce fichier :      cp .env.example .env
# 2. Remplacer chaque valeur entre chevrons par la vraie valeur (sans les chevrons).
# 3. Protéger le fichier :    chmod 600 .env
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).
# Mettre la valeur entre guillemets si elle contient un espace ou un #.

DB_HOST=localhost
DB_USER=<UTILISATEUR_BDD>
DB_PASSWORD=<MOT_DE_PASSE_BDD>
DB_NAME=mp1_surveillance
API_HOST=0.0.0.0
API_PORT=5000
